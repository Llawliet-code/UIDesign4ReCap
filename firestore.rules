rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects — public read and write
    // TODO: Restrict write to authenticated admin/librarian roles before production
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Users — each user can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved projects — authenticated users can only access their own
    match /savedProjects/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.projectId is string;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Conversations — authenticated users can only access their own
    match /conversations/{userId} {
      // Read/Write: must be authenticated and userId must match their own UID
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
