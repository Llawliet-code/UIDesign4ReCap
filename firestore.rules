rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects — public read, authenticated write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users — each user can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved projects — authenticated users can only access their own
    match /savedProjects/{docId} {
      // Read: must own the document
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Create: must be authenticated and userId must match their own UID
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.projectId is string;

      // Delete: must own the document
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
